# Copiá este archivo como .env.local y completá los valores.
# .env.local NO se sube al repositorio.

# Token de larga duración de la API de Instagram (cuenta Profesional @nexcoreandes).
# Sin este valor, la sección Instagram muestra las 3 publicaciones de respaldo de public/social/.
INSTAGRAM_ACCESS_TOKEN=

# Dominio definitivo del sitio (para las vistas previas al compartir en redes)
NEXT_PUBLIC_SITE_URL=https://nexcoreandes.com
